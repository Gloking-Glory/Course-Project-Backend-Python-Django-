container_commands:
  00_wait_for_db:
    command: "until nc -z -v -w30 $DB_HOST $DB_PORT; do echo 'Waiting for database...'; sleep 5; done"
  01_migrate:
    command: "python manage.py migrate --noinput"
    leader_only: true

option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: jeceProject/wsgi.py
