packages:
  dnf:
    git: []
    gcc: []
    python3-devel: []
    postgresql15-devel: []

commands:
  01_upgrade_pip:
    command: "python3 -m pip install --upgrade pip || true"

  02_install_requirements:
    command: "pip install -r /var/app/staging/requirements.txt"

container_commands:
  01_migrate:
    command: "python manage.py migrate --noinput"
    leader_only: true

  02_collectstatic:
    command: "python manage.py collectstatic --noinput"
    leader_only: true

files:
  "/etc/httpd/conf.d/static.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      Alias /static/ /var/app/current/static/
      <Directory /var/app/current/static>
          Require all granted
      </Directory>
